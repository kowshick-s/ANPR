<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <com.vehiclegate.anpr.ui.AspectFrameLayout
        android:id="@+id/aspect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <TextureView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.vehiclegate.anpr.ui.RoiOverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.vehiclegate.anpr.ui.AspectFrameLayout>

    <!-- Stream info -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/label_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/camTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Status in the middle while connecting / on error -->
    <TextView
        android:id="@+id/centerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/label_bg"
        android:gravity="center"
        android:maxWidth="520dp"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Bottom: plate results + actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/ocrResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/label_bg"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="@color/live"
            android:textSize="14sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnReadPlate"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍 Read plate now" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTest"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Connection test" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnReconnect"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Reconnect" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTransport"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Transport: TCP" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRoi"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Hide search area" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnClose"
                    style="@style/TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Close" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
