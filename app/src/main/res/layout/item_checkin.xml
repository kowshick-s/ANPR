<?xml version="1.0" encoding="utf-8"?>
<!-- One parked vehicle, one line: number · Token/Name (type here) · time · Check out (tap twice) · ▾.
     ▾ opens: correct the number, model, picture. Long-press the time = delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="2dp"
    android:paddingEnd="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/mark"
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="@color/checkin" />

        <TextView
            android:id="@+id/plateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:background="@drawable/row_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="4"
            android:background="@drawable/cell_field_bg"
                android:minHeight="34dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
            android:hint="Token / Name"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textCapWords"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/when"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="3"
            android:background="@drawable/row_bg"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="2"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/out"
            style="@style/TvButton.OutSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minHeight="32dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Out ₹10" />

        <ImageButton
            android:id="@+id/chevron"
            style="@style/IconButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="More"
            android:padding="5dp"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/plate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:background="@drawable/cell_field_bg"
                android:minHeight="34dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
            android:fontFamily="@font/inter_semibold"
            android:hint="Correct the number"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:textSize="14sp" />

        <AutoCompleteTextView
            android:id="@+id/model"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="4"
            android:background="@drawable/cell_field_bg"
                android:minHeight="34dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
            android:completionThreshold="1"
            android:dropDownWidth="260dp"
            android:hint="Model"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textCapWords"
            android:popupBackground="@drawable/card_bg"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/photo"
            style="@style/IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="View picture"
            android:padding="8dp"
            android:src="@drawable/ic_photo" />

        <ImageView
            android:id="@+id/plateThumb"
            android:layout_width="78dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/thumb_bg"
            android:contentDescription="Plate"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
