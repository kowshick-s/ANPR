<?xml version="1.0" encoding="utf-8"?>
<!-- One parked vehicle: type Token / Name / Model directly (saved on Done or when leaving the box) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:paddingRight="4dp">

    <View
        android:id="@+id/mark"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@color/checkin" />

    <TextView
        android:id="@+id/plate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:background="@drawable/row_bg"
        android:focusable="true"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="2"
        android:padding="3dp"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/token"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_weight="2"
        android:background="@drawable/cell_field_bg"
        android:hint="Token"
        android:imeOptions="actionNext"
        android:inputType="text"
        android:paddingLeft="7dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="#55FFFFFF"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_weight="3"
        android:background="@drawable/cell_field_bg"
        android:hint="Name"
        android:imeOptions="actionNext"
        android:inputType="textPersonName|textCapWords"
        android:paddingLeft="7dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="#55FFFFFF"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/model"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_weight="3"
        android:background="@drawable/cell_field_bg"
        android:hint="Model"
        android:imeOptions="actionDone"
        android:inputType="textCapWords"
        android:paddingLeft="7dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="#55FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/when"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_weight="2.4"
        android:fontFamily="monospace"
        android:gravity="end"
        android:maxLines="2"
        android:textColor="@color/checkin"
        android:textSize="12sp" />
</LinearLayout>
