<?xml version="1.0" encoding="utf-8"?>
<!-- One parked vehicle. Everything is edited in the row (no pop-ups): number, Token/Name, Model.
     Saved on Done/Next or when leaving the box. Out = vehicle leaving. Long-press the time = delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingRight="2dp">

    <View
        android:id="@+id/mark"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@color/checkin" />

    <EditText
        android:id="@+id/plate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:background="@drawable/cell_field_bg"
        android:paddingLeft="7dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="#55FFFFFF"
        android:fontFamily="sans-serif-condensed"
        android:hint="Vehicle no."
        android:imeOptions="actionNext|flagNoExtractUi"
        android:inputType="textCapCharacters|textNoSuggestions"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="4"
        android:background="@drawable/cell_field_bg"
        android:paddingLeft="7dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="#55FFFFFF"
        android:hint="Token / Name"
        android:imeOptions="actionNext|flagNoExtractUi"
        android:inputType="textCapWords"
        android:textSize="14sp" />

    <AutoCompleteTextView
        android:id="@+id/model"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="3"
        android:background="@drawable/cell_field_bg"
        android:paddingLeft="7dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="#55FFFFFF"
        android:completionThreshold="1"
        android:hint="Model"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:inputType="textCapWords"
        android:popupBackground="@color/surface2"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/when"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="2.4"
        android:fontFamily="monospace"
        android:gravity="end"
        android:maxLines="3"
        android:textColor="@color/checkin"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:background="@drawable/focus_bg"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp"
        android:text="📷"
        android:textSize="18sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/out"
        style="@style/TvButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Out"
        android:textColor="@color/checkout"
        android:textStyle="bold" />
</LinearLayout>
