<?xml version="1.0" encoding="utf-8"?>
<!-- One parked vehicle. Everything is edited in the row (no pop-ups): number, Token/Name, Model.
     Saved automatically. Out = vehicle leaving. Long-press the time = delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="5dp"
    android:paddingEnd="4dp"
    android:paddingBottom="5dp">

    <View
        android:id="@+id/mark"
        android:layout_width="3dp"
        android:layout_height="28dp"
        android:layout_marginEnd="8dp"
        android:background="@color/checkin" />

    <EditText
        android:id="@+id/plate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:background="@drawable/cell_field_bg"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:fontFamily="@font/inter_semibold"
        android:hint="Vehicle no."
        android:imeOptions="actionNext|flagNoExtractUi"
        android:inputType="textCapCharacters|textNoSuggestions"
        android:letterSpacing="0.02"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="4"
        android:background="@drawable/cell_field_bg"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:hint="Token / Name"
        android:imeOptions="actionNext|flagNoExtractUi"
        android:inputType="textCapWords"
        android:textSize="14sp" />

    <AutoCompleteTextView
        android:id="@+id/model"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="3"
        android:background="@drawable/cell_field_bg"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:completionThreshold="1"
        android:dropDownWidth="260dp"
        android:hint="Model"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:inputType="textCapWords"
        android:popupBackground="@drawable/card_bg"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/when"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="2.4"
        android:background="@drawable/row_bg"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:maxLines="3"
        android:padding="4dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/photo"
        style="@style/IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:contentDescription="View picture"
        android:padding="9dp"
        android:src="@drawable/ic_photo" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/out"
        style="@style/TvButton.OutSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Out" />
</LinearLayout>
