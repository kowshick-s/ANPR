<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: section list (left) · selected section (right). Saved automatically. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">
            <ImageButton
                android:id="@+id/save"
                style="@style/IconButton"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Settings"
                android:textColor="@color/text"
                android:textSize="20sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/sectionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp" />
        </ScrollView>
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/divider" />

    <ScrollView
        android:id="@+id/pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/paneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/text"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/paneSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

<LinearLayout android:id="@+id/secCameras" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Add every camera that sees the entry lane. Reads from all cameras are compared to pick the most accurate plate. 2–4 cameras recommended." android:textColor="@color/text_dim" android:textSize="13sp" />
<LinearLayout
                android:id="@+id/cameraList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/addCamera"
                    style="@style/TvButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Add camera" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/addNvr"
                    style="@style/TvButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="+ Add NVR / DVR channels" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/addTestVideo"
                    style="@style/TvButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="+ Add test video (play a saved clip as a camera)" />
            </LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/secParking" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fee (₹) for every started period" />
<EditText android:id="@+id/feeAmount" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Period (hours) – 24 = per day" />
<EditText android:id="@+id/feePeriodHours" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monthly users: still at the gate if seen again within (minutes)" />
<EditText android:id="@+id/minStayMinutes" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
</LinearLayout>
<LinearLayout android:id="@+id/secMonthly" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Monthly users are checked in and out automatically by the cameras, pay no daily fee and are shown in purple." android:textColor="@color/text_dim" android:textSize="13sp" />
<androidx.appcompat.widget.AppCompatButton
                android:id="@+id/monthlyUsers"
                style="@style/TvButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Monthly users (master list) →"
                android:textColor="@color/monthly_text" />
</LinearLayout>
<LinearLayout android:id="@+id/secUsers" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Admin: everything (cameras, settings, fees, users, delete, exit). Staff: the counter – check in and out. TV display: the dashboard only." android:textColor="@color/text_dim" android:textSize="13sp" />
<androidx.appcompat.widget.AppCompatButton
                android:id="@+id/usersButton"
                style="@style/TvButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Users &amp; roles (admin, staff, TV displays) →" />
</LinearLayout>
<LinearLayout android:id="@+id/secDetection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<CheckBox
                android:id="@+id/useAiPlates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/row_bg"
                android:padding="6dp"
                android:text="Use the AI plate detector and reader"
                android:textColor="@color/text" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:layout_marginBottom="6dp" android:text="Recommended. Turn off only to compare with the classic plate finder." android:textColor="@color/text_dim" android:textSize="12sp" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Common state codes at this site. Telangana = TS and TG" />
<EditText android:id="@+id/commonStates" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" />
<CheckBox
                android:id="@+id/strictStates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/row_bg"
                android:padding="6dp"
                android:text="Accept only these states and full numbers"
                android:textColor="@color/text" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:layout_marginBottom="6dp" android:text="2-digit district and 4-digit number. Rejects misreads like CH 8 A 06." android:textColor="@color/text_dim" android:textSize="12sp" />
<CheckBox
                android:id="@+id/movingOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/row_bg"
                android:padding="6dp"
                android:text="Log only moving vehicles"
                android:textColor="@color/text" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:layout_marginBottom="6dp" android:text="Parked vehicles in view are ignored." android:textColor="@color/text_dim" android:textSize="12sp" />
<CheckBox
                android:id="@+id/beep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/row_bg"
                android:padding="6dp"
                android:text="Beep when a vehicle is captured"
                android:textColor="@color/text" />
<TextView android:id="@+id/advancedToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/row_bg" android:clickable="true" android:drawableEnd="@drawable/ic_expand" android:drawablePadding="6dp" android:focusable="true" android:fontFamily="@font/inter_semibold" android:gravity="center_vertical" android:padding="6dp" android:text="Advanced" android:textColor="@color/accent" android:textSize="14sp" />
<LinearLayout android:id="@+id/advancedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Change these only if detection misbehaves." android:textColor="@color/text_dim" android:textSize="13sp" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Re-entry cooldown (seconds)" />
<EditText android:id="@+id/cooldown" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minimum reads to accept a vehicle (across all cameras)" />
<EditText android:id="@+id/minReads" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Decision delay (ms)" />
<EditText android:id="@+id/settle" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reading interval per camera (ms)" />
<EditText android:id="@+id/ocrInterval" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minimum confidence (%)" />
<EditText android:id="@+id/minConf" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
</LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/secDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Appearance" />
<RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton android:id="@+id/themeSystem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Same as device" />
                <RadioButton android:id="@+id/themeLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Light" />
                <RadioButton android:id="@+id/themeDark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dark" />
            </RadioGroup>
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Screen title (site or gate name)" />
<EditText android:id="@+id/siteTitle" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voice input language" />
<RadioGroup
                android:id="@+id/voiceGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton android:id="@+id/voiceTamil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tamil + English (mixed)" />
                <RadioButton android:id="@+id/voiceEnglish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="English only" />
            </RadioGroup>
<CheckBox
                android:id="@+id/liveVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/row_bg"
                android:padding="6dp"
                android:text="Show live camera video on the counter"
                android:textColor="@color/text" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:layout_marginBottom="6dp" android:text="Off = small status chips. Use Preview to watch one camera." android:textColor="@color/text_dim" android:textSize="12sp" />
</LinearLayout>
<LinearLayout android:id="@+id/secPictures" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<CheckBox
                android:id="@+id/plateCropOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Save only the plate picture" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:layout_marginBottom="6dp" android:text="About 10 KB per vehicle instead of about 50 KB with the small scene picture." android:textColor="@color/text_dim" android:textSize="12sp" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delete pictures after check-out (days, 0 = keep)" />
<EditText android:id="@+id/keepPicturesDays" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keep history for (days, 0 = forever)" />
<EditText android:id="@+id/retention" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
<androidx.appcompat.widget.AppCompatButton
            android:id="@+id/exportCsv"
            style="@style/TvButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export history (CSV)" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:fontFamily="@font/inter_semibold" android:text="Danger zone" android:textColor="@color/error" android:textSize="14sp" />
<androidx.appcompat.widget.AppCompatButton
            android:id="@+id/clearHistory"
            style="@style/TvButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear history"
            android:textColor="@color/error" />
</LinearLayout>
<LinearLayout android:id="@+id/secBackup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email backup" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Every hour (only if something changed): a printable PDF of all parked vehicles and today&#39;s CSV. If the app or phone fails, print the last email and continue on paper. Needs a Gmail app password: Google Account → Security → 2-Step Verification on → App passwords." android:textColor="@color/text_dim" android:textSize="13sp" />
<CheckBox android:id="@+id/backupEnabled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Send the hourly backup email" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your Gmail (sends and receives)" />
<EditText android:id="@+id/backupGmail" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:hint="name@gmail.com" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gmail app password (16 letters)" />
<EditText android:id="@+id/backupPassword" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
<TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Also send to (optional, comma separated)" />
<EditText android:id="@+id/backupAlsoTo" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/backupStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_dim" android:textSize="13sp" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/backupNow" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save and send now" />
            </LinearLayout>
<TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Cloud copy" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Coming next: every change copied to your Firebase cloud, shared between devices and restored after a reinstall." android:textColor="@color/text_dim" android:textSize="13sp" />
<TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Settings file" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Save all settings and cameras to a file (Downloads), or load them on another device." android:textColor="@color/text_dim" android:textSize="13sp" />
<androidx.appcompat.widget.AppCompatButton
            android:id="@+id/exportSettings"
            style="@style/TvButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Backup settings" />
<androidx.appcompat.widget.AppCompatButton
            android:id="@+id/importSettings"
            style="@style/TvButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Restore settings" />
</LinearLayout>
<LinearLayout android:id="@+id/secProtection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:id="@+id/protectStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_dim" android:textSize="13sp" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/protectAdmin" style="@style/TvButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
<CheckBox android:id="@+id/protectKiosk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Kiosk mode" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:layout_marginBottom="6dp" android:text="Blocks uninstall, keeps the device in the app and opens it after a restart." android:textColor="@color/text_dim" android:textSize="12sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:fontFamily="@font/inter_semibold" android:text="Danger zone" android:textColor="@color/error" android:textSize="14sp" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/protectRelease" style="@style/TvButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Release this device (allow uninstall again)" android:textColor="@color/error" />
</LinearLayout>
<LinearLayout android:id="@+id/secAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:id="@+id/aboutText" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="4dp" android:textColor="@color/text" android:textSize="15sp" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/checkUpdate" style="@style/TvButton.Filled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Check for update" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Opens the latest version. Installing it keeps all data and settings." android:textColor="@color/text_dim" android:textSize="13sp" />
</LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
