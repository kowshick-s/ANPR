<?xml version="1.0" encoding="utf-8"?>
<!-- Waiting-list card: picture, best reading, other readings. Tap = open the check-in editor in the card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/capture_card_bg"
    android:orientation="vertical"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/capture_head_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="78dp"
            android:layout_height="30dp"
            android:background="@drawable/thumb_bg"
            android:contentDescription="Picture"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/plate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0.02"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/alts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:singleLine="true"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/confirm"
            style="@style/TvButton.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="34dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Check in" />

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/chipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editPlate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:background="@drawable/cell_field_bg"
            android:minHeight="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
                android:fontFamily="@font/inter_semibold"
                android:hint="Vehicle no."
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:textSize="15sp"     android:drawableEnd="@drawable/ic_mic"
                android:drawablePadding="4dp"
                />

            <EditText
                android:id="@+id/editName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="4"
                android:background="@drawable/cell_field_bg"
            android:minHeight="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
                android:hint="Token / Name"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textCapWords"
                android:textSize="14sp"     android:drawableEnd="@drawable/ic_mic"
                android:drawablePadding="4dp"
                />

            <AutoCompleteTextView
                android:id="@+id/editModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="3"
                android:background="@drawable/cell_field_bg"
            android:minHeight="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
                android:completionThreshold="1"
                android:dropDownWidth="260dp"
                android:hint="Model"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textCapWords"
                android:popupBackground="@drawable/card_bg"
                android:textSize="14sp"     android:drawableEnd="@drawable/ic_mic"
                android:drawablePadding="4dp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badge"
                style="@style/Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/badge_checkout_bg"
                android:textColor="@color/checkout"
                android:visibility="gone" />

            <TextView
                android:id="@+id/editHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/speak"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_mic"
                android:drawablePadding="6dp"
                android:paddingStart="12dp"
                android:text="Speak" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/alt"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/ignore"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ignore"
                android:textColor="@color/text_dim" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
