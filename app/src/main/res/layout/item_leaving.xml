<?xml version="1.0" encoding="utf-8"?>
<!-- Vehicle seen leaving: correct the number in the box, collect the amount, Check out. ✕ = not leaving. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="2dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <EditText
            android:id="@+id/plate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cell_field_bg"
            android:fontFamily="@font/inter_semibold"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:letterSpacing="0.02"
            android:minHeight="38dp"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/row_bg"
            android:clickable="true"
            android:drawableStart="@drawable/ic_photo_small"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:singleLine="true"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/checkout"
        style="@style/TvButton.Checkout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Check out ₹10" />

    <ImageButton
        android:id="@+id/notLeaving"
        style="@style/IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:contentDescription="Not leaving – keep parked"
        android:src="@drawable/ic_close" />
</LinearLayout>
