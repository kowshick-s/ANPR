<?xml version="1.0" encoding="utf-8"?>
<!-- Indian number plate look: white, thin black border -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#FFFFFF" /><stroke android:width="3dp" android:color="@color/accent" /><corners android:radius="5dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#FFFFFF" /><stroke android:width="1.5dp" android:color="#1A1A1A" /><corners android:radius="5dp" /></shape></item>
</selector>
