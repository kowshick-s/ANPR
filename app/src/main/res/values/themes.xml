<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VehicleGate" parent="Theme.Material3.Dark.NoActionBar">
        <!-- landscape phones: type in the box itself, never in a full-screen editor -->
        <item name="android:editTextStyle">@style/InlineEditText</item>
        <item name="android:autoCompleteTextViewStyle">@style/InlineAutoComplete</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="TvButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/focus_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="Field">
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">10dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="InlineEditText" parent="Widget.AppCompat.EditText">
        <item name="android:imeOptions">flagNoExtractUi</item>
    </style>
    <style name="InlineAutoComplete" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:imeOptions">flagNoExtractUi</item>
    </style>
</resources>
